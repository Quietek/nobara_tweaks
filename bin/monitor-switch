#!/usr/bin/env bash

while getopts r:t: flag
do
    case "${flag}" in
        r) resolution=${OPTARG};;
        t) toggle=${OPTARG};;
    esac
done
config_file=~/.config/sway/config_monitor
profile_file=~/.profile
case "${resolution}" in
    0)  sed -i 's/output DP-2 pos.*/output DP-2 disable/' $config_file;;
    640) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 640x480@60Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 640x480@60Hz/' $config_file;;
    800) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 800x600@60Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 800x600@60Hz/' $config_file;;
    1024) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 1024x768@60Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 1024x768@60Hz/' $config_file;;
    1280) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 1280x960@60Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 1280x960@60Hz/' $config_file;;
    1600) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 1600x1200@85Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 1600x1200@85Hz/' $config_file;;
    1920) sed -i 's/output DP-2 pos.*/output DP-2 pos 0 2160 resolution --custom 1920x1440@60Hz/' $config_file
        sed -i 's/output DP-2 disable/output DP-2 pos 0 2160 resolution --custom 1920x1440@60Hz/' $config_file;;
    *) 
        if grep -q "output DP-2 disable" $config_file; then
            resolution=0
        else
            tempstr=$(grep 'custom' $config_file)
            tempstr=$(cut -d x -f 1 <<< ${tempstr})
            tempstr=$(cut -d m -f 2 <<< ${tempstr})
            resolution=$(echo ${tempstr} | xargs) 
        fi;;
esac

sed -i "s/output DP-1 pos.*scale/output DP-1 pos ${resolution} 2160 scale/" $config_file 

sed -i "s/output DP-3 pos.*scale/output DP-3 pos ${resolution} 0 scale/" $config_file

case "${toggle}" in
    dp1) 
        sed -i "s/HDMI-A-1/DP-1/" $profile_file;;
    dp2)
        echo "Please use the -r flag to toggle display DP-2";;
    dp3) 
        if grep -q "output DP-3 disable" $config_file; then
            sed -i "s/output DP-3 disable/output DP-3 pos ${resolution} 0 scale 1 resolution 3840x2160@119.910Hz transform 180 adaptive_sync on/" $config_file
        else
            sed -i "s/output DP-3 pos.*/output DP-3 disable/" $config_file;
        fi;;
    hdmi1)
        sed -i "s/DP-1/HDMI-A-1/" $profile_file;;
esac

